{
  "hosting": {
    "site": "onn-off-ingenierie",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "decouper.js",
      "**/.*",
      "**/node_modules/**",
      "**/*.bak",
      "**/_backup_*",
      "CNAME",
      "**/.git/**",
      "**/.firebase/**",
      "README.md",
      "_AVANT-*/**",
      "_sauvegarde*/**",
      "**/_restaure-en-ligne/**"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "cleanUrls": true
  }
}
